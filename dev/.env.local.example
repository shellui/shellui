# Shellui local dev stack. From dev/: ./generate-env.sh (creates .env.local, gitignored).
# Sibling repos sit next to this monorepo: ../../identity-service from dev/, ../identity-service from repo root.

# --- Shared infrastructure ---
POSTGRES_USER=shellui
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=postgres

# --- Public URLs (browser, issuers, OAuth, CORS) ---
PUBLIC_SHELL_URL=http://localhost:4000
PUBLIC_IDENTITY_URL=http://localhost:8001
PUBLIC_STORAGE_URL=http://localhost:8002
PUBLIC_HOSTING_URL=http://localhost:8003
PUBLIC_EMAIL_URL=http://localhost:8004
PUBLIC_SAAS_URL=http://localhost:8005
PUBLIC_AI_URL=http://localhost:8006
PUBLIC_ADMIN_URL=http://localhost:5173
PUBLIC_DASHBOARD_URL=http://localhost:5174
PUBLIC_FILES_URL=http://localhost:5175
PUBLIC_PLAYGROUND_URL=http://localhost:5176

JWT_AUDIENCE=shellui

# Set after creating a company in identity (manage.py or admin UI). Default 1 for first company.
SHELL_IDENTITY_COMPANY_ID=1
DASHBOARD_IDENTITY_COMPANY_ID=1

# Dashboard multi-region origins (REGION_<CODE>_*_ORIGIN); code is `local`.
DEV_REGION_CODE=local
REGION_LOCAL_IDENTITY_ORIGIN=${PUBLIC_IDENTITY_URL}
REGION_LOCAL_STORAGE_ORIGIN=${PUBLIC_STORAGE_URL}
REGION_LOCAL_HOSTING_ORIGIN=${PUBLIC_HOSTING_URL}
REGION_LOCAL_EMAIL_ORIGIN=${PUBLIC_EMAIL_URL}
REGION_LOCAL_SAAS_ORIGIN=${PUBLIC_SAAS_URL}
REGION_LOCAL_AI_ORIGIN=${PUBLIC_AI_URL}

# Comma-separated origins for Django CSRF_TRUSTED_ORIGINS on every backend service.
DEV_CSRF_TRUSTED_ORIGINS=http://localhost:4000,http://localhost:8001,http://localhost:8002,http://localhost:8003,http://localhost:8004,http://localhost:8005,http://localhost:8006,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# --- identity-service ---
IDENTITY_SECRET_KEY=__IDENTITY_SECRET_KEY__
IDENTITY_JWT_PRIVATE_KEY="__JWT_PRIVATE_KEY__"
IDENTITY_JWT_PUBLIC_KEY="__JWT_PUBLIC_KEY__"
IDENTITY_JWT_KEY_ID=__JWT_KEY_ID__
IDENTITY_REDIS_URL=redis://redis:6379/0
IDENTITY_POSTGRES_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/identity
IDENTITY_EMAIL_SERVICE_API_KEY=__ESK_IDENTITY__
IDENTITY_DASHBOARD_WEBHOOK_URL=${PUBLIC_SAAS_URL}/api/v1/webhooks/local
IDENTITY_DASHBOARD_WEBHOOK_INTERNAL_URL=http://saas:8000/api/v1/webhooks/local
IDENTITY_DASHBOARD_WEBHOOK_SECRET=__DASHBOARD_WEBHOOK_SECRET__

# --- storage-service (Redis DB 1) ---
STORAGE_SECRET_KEY=__STORAGE_SECRET_KEY__
STORAGE_EMAIL_SERVICE_API_KEY=__ESK_STORAGE__
STORAGE_REDIS_URL=redis://redis:6379/1
STORAGE_POSTGRES_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/storage

# --- hosting-service (Redis DB 2) ---
HOSTING_SECRET_KEY=__HOSTING_SECRET_KEY__
HOSTING_EMAIL_SERVICE_API_KEY=__ESK_HOSTING__
HOSTING_REDIS_URL=redis://redis:6379/2
HOSTING_POSTGRES_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/hosting

# --- email-service (Redis DB 3) ---
EMAIL_SECRET_KEY=__EMAIL_SECRET_KEY__
EMAIL_REDIS_URL=redis://redis:6379/3
EMAIL_POSTGRES_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/email
EMAIL_CREDENTIALS_KEY=__EMAIL_CREDENTIALS_KEY__
EMAIL_VARIABLES_KEY=__EMAIL_VARIABLES_KEY__
EMAIL_HASH_PEPPER=__EMAIL_HASH_PEPPER__

# --- saas-service (Redis DB 4) ---
SAAS_SECRET_KEY=__SAAS_SECRET_KEY__
SAAS_EMAIL_SERVICE_API_KEY=__ESK_SAAS__
SAAS_REDIS_URL=redis://redis:6379/4
SAAS_POSTGRES_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/saas

# --- ai-service (Redis DB 5) ---
AI_SECRET_KEY=__AI_SECRET_KEY__
AI_EMAIL_SERVICE_API_KEY=__ESK_AI__
AI_REDIS_URL=redis://redis:6379/5
AI_POSTGRES_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/ai
AI_SERVICE_SIGNING_KEY="__AI_SERVICE_SIGNING_KEY__"
AI_SERVICE_SIGNING_KID=__AI_SERVICE_SIGNING_KID__

# Dev-only RS256 keys: each service signs internal MCP assertions to identity,
# saas signs provisioning assertions. Generated by generate-env.sh, never reuse in production.
STORAGE_SERVICE_SIGNING_KEY="__STORAGE_SERVICE_SIGNING_KEY__"
HOSTING_SERVICE_SIGNING_KEY="__HOSTING_SERVICE_SIGNING_KEY__"
EMAIL_SERVICE_SIGNING_KEY="__EMAIL_SERVICE_SIGNING_KEY__"
PROVISIONING_SIGNING_KEY="__PROVISIONING_SIGNING_KEY__"
PROVISIONING_PUBLIC_KEY="__PROVISIONING_PUBLIC_KEY__"

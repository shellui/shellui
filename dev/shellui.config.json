{
  "$schema": "../packages/core/schemas/shellui.config.schema.json",
  "port": 4000,
  "title": "Shellui dev stack",
  "layout": "sidebar",
  "language": "en",
  "theme": "shellui",
  "backend": {
    "type": "shellui",
    "url": "${PUBLIC_IDENTITY_URL}",
    "companyId": "${SHELL_IDENTITY_COMPANY_ID:-1}",
    "adminPathname": "/admin",
    "adminUrl": "${PUBLIC_ADMIN_URL}"
  },
  "email": {
    "url": "${PUBLIC_EMAIL_URL}"
  },
  "storage": {
    "url": "${PUBLIC_STORAGE_URL}"
  },
  "hosting": {
    "url": "${PUBLIC_HOSTING_URL}"
  },
  "navigation": [
    {
      "label": "Home",
      "path": "",
      "url": "/"
    },
    {
      "label": "Admin",
      "path": "admin",
      "url": "${PUBLIC_ADMIN_URL}/",
      "requiresStaff": true
    },
    {
      "label": "Files",
      "path": "files",
      "url": "${PUBLIC_FILES_URL}/",
      "requiresAuth": true
    },
    {
      "label": "Dashboard",
      "path": "dashboard",
      "url": "${PUBLIC_DASHBOARD_URL}/",
      "requiresStaff": true
    }
  ]
}

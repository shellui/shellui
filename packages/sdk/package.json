{
  "name": "@shellui/sdk",
  "version": "0.7.0-beta.1",
  "description": "JavaScript and TypeScript SDK for apps hosted in Shellui, the open-source app shell. Connect any framework to the host to show toasts, dialogs and drawers, follow the theme, read the signed-in user and use storage. MIT licensed.",
  "homepage": "https://shellui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellui/shellui.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/shellui/shellui/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "unpkg": "dist/shellui.tiny.js",
  "jsdelivr": "dist/shellui.tiny.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tiny": {
      "types": "./dist/tiny.d.ts",
      "import": "./dist/tiny.js",
      "default": "./dist/tiny.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-tiny.mjs",
    "test": "echo \"No tests specified for @shellui/sdk\""
  },
  "keywords": [
    "shellui",
    "sdk",
    "app shell",
    "micro frontends",
    "iframe",
    "postMessage",
    "javascript",
    "typescript",
    "react",
    "vue",
    "internal tools",
    "open source"
  ],
  "author": "Shellui",
  "license": "MIT",
  "dependencies": {
    "roarr": "^7.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}

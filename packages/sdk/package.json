{
  "name": "@shellui/sdk",
  "version": "0.5.0-alpha.2",
  "description": "Shellui SDK - TypeScript/JavaScript SDK for Shellui integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "unpkg": "dist/shellui.tiny.js",
  "jsdelivr": "dist/shellui.tiny.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tiny": {
      "types": "./dist/tiny.d.ts",
      "import": "./dist/tiny.js",
      "default": "./dist/tiny.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-tiny.mjs",
    "test": "echo \"No tests specified for @shellui/sdk\""
  },
  "keywords": [
    "shellui",
    "sdk",
    "javascript",
    "microfrontend"
  ],
  "author": "Shellui",
  "license": "MIT",
  "dependencies": {
    "roarr": "^7.21.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

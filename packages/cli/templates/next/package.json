{
  "name": "shellui-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "shellui start",
    "dev": "node scripts/ensure-port.mjs 3000 && next dev --port 3000",
    "build": "shellui build && next build && node scripts/copy-export.mjs",
    "serve:dist": "node node_modules/@shellui/cli/scripts/serve-dist.mjs",
    "start:app": "next start --port 3000",
    "lint": "eslint"
  },
  "dependencies": {
    "@shellui/sdk": "^0.5.0",
    "next": "16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@shellui/cli": "^0.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5"
  }
}

{
  "name": "@shellui/cli",
  "version": "0.8.6",
  "description": "Command-line tool for Shellui, the open-source app shell. Create a project from React, Vue, Svelte, Angular and other templates, run the dev server, build, and deploy 7-day preview links. Desktop builds with Tauri. MIT licensed.",
  "homepage": "https://shellui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellui/shellui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/shellui/shellui/issues"
  },
  "main": "src/cli.js",
  "type": "module",
  "bin": {
    "shellui": "./bin/shellui.js"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "templates/tauri",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "echo 'CLI build complete'",
    "test": "node scripts/test.js",
    "test:watch": "vitest"
  },
  "keywords": [
    "shellui",
    "cli",
    "app shell",
    "micro frontends",
    "scaffolding",
    "vite",
    "react",
    "admin dashboard",
    "internal tools",
    "preview deployments",
    "tauri",
    "open source"
  ],
  "author": "Shellui",
  "license": "MIT",
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@shellui/core": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-react": "^5.1.4",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.2",
    "cac": "^6.7.14",
    "dotenv": "^17.3.1",
    "picocolors": "^1.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "vite": "8.3.8",
    "workbox-build": "^7.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}

# Shellui self-hosted stack.
# Copy to .env, then generate secrets (writes deploy/secrets/jwks.json too):
#   cp .env.example .env
#   ./scripts/generate-secrets.sh
#
# Nothing in this file is a real secret. Empty values marked "generated" must be
# filled by the script before `docker compose up`. Do not commit .env.
#
# Images are published on Docker Hub as shellui/<service>:<version>.
# These repositories are not published to GHCR.
#
# generate-secrets.sh fills every empty value tagged "generated" and does not
# replace a value you already set.

# ---------------------------------------------------------------------------
# Images and host ports
# Published tags are the current releases. Override to pin another tag.
# Host ports are for a proxy-free install. Coolify uses deploy/coolify/docker-compose.yml
# and does not bind these ports.
# ---------------------------------------------------------------------------
IDENTITY_IMAGE=shellui/identity-service:0.7.0
STORAGE_IMAGE=shellui/storage-service:0.5.0
HOSTING_IMAGE=shellui/hosting-service:0.6.1
EMAIL_IMAGE=shellui/email-service:0.2.0
POSTGRES_IMAGE=postgres:16.15-alpine
REDIS_IMAGE=redis:8.2-alpine

IDENTITY_PUBLISH_PORT=8000
STORAGE_PUBLISH_PORT=8001
HOSTING_PUBLISH_PORT=8002
EMAIL_PUBLISH_PORT=8003

# ---------------------------------------------------------------------------
# Postgres
# One server, a separate database and role per service. The init script in
# postgres/init-databases.sh runs only when the data volume is created.
# Changing a password later does not alter an existing role.
# ---------------------------------------------------------------------------
POSTGRES_USER=shellui
# generated: hex password for the Postgres superuser (not used by the apps)
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# generated
IDENTITY_DB_PASSWORD=
# generated
STORAGE_DB_PASSWORD=
# generated
HOSTING_DB_PASSWORD=
# generated
EMAIL_DB_PASSWORD=
# generated from the role password. Points at the compose service "postgres".
IDENTITY_DATABASE_URL=
STORAGE_DATABASE_URL=
HOSTING_DATABASE_URL=
EMAIL_DATABASE_URL=
# Internal Postgres has no TLS. Leave false. Set true only for an external server that requires TLS.
POSTGRES_SSL_REQUIRE=false
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_STATEMENT_TIMEOUT=15
POSTGRES_LOCK_TIMEOUT=5

# ---------------------------------------------------------------------------
# Redis
# One server. Each service uses its own database index so caches and Celery
# queues stay apart. Not published on the host.
# ---------------------------------------------------------------------------
IDENTITY_REDIS_URL=redis://redis:6379/0
STORAGE_REDIS_URL=redis://redis:6379/1
HOSTING_REDIS_URL=redis://redis:6379/2
EMAIL_REDIS_URL=redis://redis:6379/3
# Optional separate Celery broker. Empty uses that service's REDIS_URL.
IDENTITY_CELERY_BROKER_URL=
STORAGE_CELERY_BROKER_URL=
HOSTING_CELERY_BROKER_URL=
EMAIL_CELERY_BROKER_URL=
IDENTITY_CELERY_WORKER_CONCURRENCY=2
STORAGE_CELERY_WORKER_CONCURRENCY=2
HOSTING_CELERY_WORKER_CONCURRENCY=2
EMAIL_CELERY_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Public URLs for this proxy-free install
# identity.localhost (and the other *.localhost names) resolve to 127.0.0.1.
# EMAIL_AUTH_LINK_HOSTS is the platform list for every company. email-service 0.2.0
# also allows hostnames a company adds (PUT /api/v1/auth-link-hosts or Allowed link
# hosts in Django admin) and hosts of that company's identity application URLs.
# Any other host is refused. DEBUG=false drops localhost, 127.0.0.1, and ::1,
# so the issuer host must be identity.localhost, not localhost.
# Behind Coolify these are replaced by SERVICE_URL_* / SERVICE_FQDN_*.
# ---------------------------------------------------------------------------
JWT_ISSUER=http://identity.localhost:8000
JWT_AUDIENCE=shellui
# Include the Compose DNS name (identity, storage, hosting, email) so service-to-service
# calls are accepted. Django returns 400 when the Host header is missing from this list.
IDENTITY_ALLOWED_HOSTS=identity.localhost,identity,localhost,127.0.0.1
IDENTITY_CSRF_TRUSTED_ORIGINS=http://identity.localhost:8000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:4000,http://127.0.0.1:4000
STORAGE_ALLOWED_HOSTS=storage.localhost,storage,localhost,127.0.0.1
STORAGE_CSRF_TRUSTED_ORIGINS=http://storage.localhost:8001,http://localhost:8001,http://127.0.0.1:8001
HOSTING_ALLOWED_HOSTS=hosting.localhost,hosting,localhost,127.0.0.1
HOSTING_CSRF_TRUSTED_ORIGINS=http://hosting.localhost:8002,http://localhost:8002,http://127.0.0.1:8002
EMAIL_ALLOWED_HOSTS=email.localhost,email,localhost,127.0.0.1
EMAIL_CSRF_TRUSTED_ORIGINS=http://email.localhost:8003,http://localhost:8003,http://127.0.0.1:8003
EMAIL_PUBLIC_BASE_URL=http://email.localhost:8003
EMAIL_AUTH_LINK_HOSTS=identity.localhost

# Internal addresses. Callers inside the compose network use these.
IDENTITY_SERVICE_URL=http://identity:8000
EMAIL_SERVICE_URL=http://email:8000
# storage-service and hosting-service refuse a private email URL unless this is true.
EMAIL_SERVICE_ALLOW_PRIVATE=true

# ---------------------------------------------------------------------------
# Shared process defaults
# DEBUG stays off. SECURE_SSL_REDIRECT stays off so HTTP health checks and this
# proxy-free install work. Turn the cookie flags on when the public URL is https
# (the Coolify template does).
# ---------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Comma-separated proxy IPs or CIDRs allowed to set X-Forwarded-For. Empty trusts REMOTE_ADDR only.
TRUSTED_PROXY_IPS=

# ---------------------------------------------------------------------------
# identity-service
# Django secret, RS256 key, and JWKS. generated.
# The private key is a PKCS#8 PEM with \n between lines. JWKS is public.
# scripts/generate-secrets.sh writes deploy/secrets/jwks.json from this key.
# ---------------------------------------------------------------------------
IDENTITY_SECRET_KEY=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY=
JWT_PREVIOUS_KEY_ID=
JWT_ACCEPT_HS256_LEGACY=false
# Seconds. A suffix (5m, 7d) also works in this file.
JWT_ACCESS_TOKEN_LIFETIME=300
JWT_REFRESH_TOKEN_LIFETIME=604800
OAUTH_TOKEN_DELIVERY=code
OAUTH_SESSION_CODE_TTL_SECONDS=120
# Provider ids that skip account confirmation. Compose substitutes google when this is empty.
# A non-empty value is passed through as written.
OAUTH_SKIP_CONFIRM_PROVIDERS=
# Leave empty. Production creates the first superuser with createsuperuser, not the web form.
SETUP_TOKEN=
# Empty follows DEBUG (false here), so loopback OAuth redirects are refused.
OAUTH_ALLOW_LOOPBACK_REDIRECTS=
SELF_SERVICE_ACCOUNT_DELETE_MAX_IAT_AGE=300
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_OAUTH=30
AUTH_RATE_LIMIT_TOKEN_REFRESH=60
AUTH_RATE_LIMIT_SETTINGS=30
AUTH_RATE_LIMIT_ADMIN_LOGIN=10
AUTH_RATE_LIMIT_PAT=30
AUTH_RATE_LIMIT_MAGIC_LINK=10
MAGIC_LINK_ENABLED=true
MAGIC_LINK_TTL_SECONDS=1800
PERSONAL_ACCESS_TOKEN_LIFETIME=30d
SCIM_ENABLED=true
IDENTITY_CORS_ALLOW_ALL_ORIGINS=true
IDENTITY_CORS_ALLOW_CREDENTIALS=false
IDENTITY_CORS_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://identity.localhost:8000
IDENTITY_CORS_ALLOWED_ORIGIN_REGEXES=
IDENTITY_GUNICORN_WORKERS=2
IDENTITY_GUNICORN_THREADS=4
IDENTITY_GUNICORN_TIMEOUT=60
IDENTITY_GUNICORN_GRACEFUL_TIMEOUT=30
IDENTITY_GUNICORN_KEEP_ALIVE=75
IDENTITY_GUNICORN_MAX_REQUESTS=1000
IDENTITY_GUNICORN_MAX_REQUESTS_JITTER=200
EMAIL_TIMEOUT=10
EMAIL_SERVICE_TIMEOUT_SECONDS=5
EMAIL_SERVICE_SEND_ATTEMPTS=3
EMAIL_SERVICE_RETRY_MAX_SLEEP_SECONDS=1
SLOW_REQUEST_THRESHOLD_SECONDS=2
# generated by scripts/bootstrap.sh after email-service is up. esk_ prefix.
EMAIL_SERVICE_API_KEY_IDENTITY=
IDENTITY_ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
IDENTITY_ACTIONS_OUTBOX_MAX_ATTEMPTS=8
IDENTITY_ACTIONS_WEBHOOK_ALLOW_PRIVATE=false
IDENTITY_ACTIONS_WEBHOOK_RETRY_LEASE_SECONDS=120
IDENTITY_ACTIONS_WEBHOOK_DISPATCH_WORKERS=4

# ---------------------------------------------------------------------------
# storage-service
# ---------------------------------------------------------------------------
STORAGE_SECRET_KEY=
STORAGE_SETUP_TOKEN=
STORAGE_CORS_ALLOW_ALL_ORIGINS=true
STORAGE_CORS_ALLOW_CREDENTIALS=false
STORAGE_CORS_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://storage.localhost:8001
# generated. Same document as deploy/secrets/jwks.json. The file is what the containers mount.
IDENTITY_JWKS=
IDENTITY_JWKS_URL=
STORAGE_JWKS_CACHE_TTL=900
STORAGE_JWKS_TIMEOUT=15
STORAGE_JWKS_RETRIES=2
# Leave empty. HS256 fallback is refused when DEBUG=false.
JWT_HS256_FALLBACK_SECRET=
JWT_ALGORITHMS=RS256
STORAGE_BACKEND=filesystem
STORAGE_KEY_PREFIX=shellui
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=
SIGNED_URL_EXPIRES=3600
DEFAULT_COMPANY_QUOTA_BYTES=10G
DEFAULT_USER_QUOTA_BYTES=0
MAX_UPLOAD_BYTES=5G
WEBDAV_ENABLED=true
WEBDAV_PATH_PREFIX=/dav
DJANGO_ADMIN_ENABLED=true
STORAGE_GUNICORN_WORKERS=2
STORAGE_GUNICORN_THREADS=2
STORAGE_GUNICORN_TIMEOUT=120
STORAGE_GUNICORN_GRACEFUL_TIMEOUT=30
STORAGE_GUNICORN_KEEP_ALIVE=75
STORAGE_GUNICORN_MAX_REQUESTS=1000
STORAGE_GUNICORN_MAX_REQUESTS_JITTER=200
STORAGE_ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
STORAGE_ACTIONS_OUTBOX_MAX_ATTEMPTS=8
STORAGE_ACTIONS_WEBHOOK_ALLOW_PRIVATE=false
STORAGE_ACTIONS_WEBHOOK_RETRY_LEASE_SECONDS=120
STORAGE_ACTIONS_WEBHOOK_DISPATCH_WORKERS=4
STORAGE_ACTIONS_WEBHOOK_SYNC_DELIVERY=false
STORAGE_EVENT_LOG_RETENTION_DAYS=7
# generated by scripts/bootstrap.sh
EMAIL_SERVICE_API_KEY_STORAGE=

# ---------------------------------------------------------------------------
# hosting-service
# HOSTING_APP_DOMAIN is the parent domain for deployed apps ({slug}.shellui.local).
# This compose file does not serve wildcard DNS for that domain.
# ---------------------------------------------------------------------------
HOSTING_SECRET_KEY=
HOSTING_SETUP_TOKEN=
HOSTING_CORS_ALLOW_ALL_ORIGINS=true
HOSTING_CORS_ALLOW_CREDENTIALS=false
HOSTING_CORS_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://hosting.localhost:8002
HOSTING_JWKS_CACHE_TTL=900
HOSTING_JWKS_TIMEOUT=15
HOSTING_JWKS_RETRIES=2
HOSTING_BACKEND=filesystem
HOSTING_KEY_PREFIX=hosting
HOSTING_AWS_ACCESS_KEY_ID=
HOSTING_AWS_SECRET_ACCESS_KEY=
HOSTING_AWS_STORAGE_BUCKET_NAME=
HOSTING_AWS_S3_REGION_NAME=us-east-1
HOSTING_AWS_S3_ENDPOINT_URL=
HOSTING_AWS_S3_CUSTOM_DOMAIN=
HOSTING_AWS_S3_SIGNATURE_VERSION=s3v4
HOSTING_AWS_S3_ADDRESSING_STYLE=
HOSTING_APP_DOMAIN=shellui.local
HOSTING_APP_SCHEME=http
HOSTING_ALLOW_ANY_HOST=false
# Must stay false while DEBUG=false. The image refuses to start otherwise.
HOSTING_DEBUG_OPEN=false
HOSTING_RATE_LIMIT_ENABLED=true
HOSTING_RATE_LIMIT_DEPLOY=30
HOSTING_RATE_LIMIT_UPLOAD=20
HOSTING_RATE_LIMIT_DESTRUCTIVE=10
HOSTING_RATE_LIMIT_ACCESS_REQUEST=10
HOSTING_SERVE_CACHE_TTL_SECONDS=45
ROOT_REDIRECT_URL=
SHELLUI_WEBSITE_URL=https://shellui.com
SHELLUI_DOCS_URL=https://docs.shellui.com
SHELLUI_PLAYGROUND_URL=https://playground.shellui.com
SHELLUI_GITHUB_URL=https://github.com/shellui
SHELLUI_AI_URL=https://shellui.ai
HOSTING_MAX_APPS_PER_COMPANY=5
HOSTING_MAX_DEPLOYMENTS_PER_APP=20
HOSTING_MAX_UPLOAD_BYTES=100M
HOSTING_MAX_EXTRACT_FILES=5000
HOSTING_MAX_EXTRACT_BYTES=500M
HOSTING_MAX_EXTRACT_FILE_BYTES=100M
HOSTING_GUNICORN_WORKERS=2
HOSTING_GUNICORN_THREADS=2
HOSTING_GUNICORN_TIMEOUT=120
HOSTING_ACTIONS_OUTBOX_MAX_ATTEMPTS=8
HOSTING_ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
HOSTING_ACTIONS_WEBHOOK_RETRY_LEASE_SECONDS=120
HOSTING_ACTIONS_WEBHOOK_DISPATCH_WORKERS=4
HOSTING_ACTIONS_WEBHOOK_SYNC_DELIVERY=false
HOSTING_ACTIONS_WEBHOOK_ALLOW_PRIVATE=false
HOSTING_EVENT_LOG_RETENTION_DAYS=7
# generated by scripts/bootstrap.sh
EMAIL_SERVICE_API_KEY_HOSTING=

# ---------------------------------------------------------------------------
# email-service 0.2.0
# Fallback provider is none until you set resend or smtp and the matching credentials.
# Fernet keys and the hash pepper are generated. Changing a Fernet key makes stored
# credentials unreadable.
# 0.2.0 does not add a required variable. Lane workers on the worker container
# write a heartbeat; a lane is stale after 60 seconds (not configurable).
# Staff read scheduler and lane health at GET /api/v1/scheduled-jobs.
# Beat stays on the worker. The web process leaves SCHEDULER_ENABLED and
# EMAIL_WORKERS_ENABLED off so jobs are not run twice.
# ---------------------------------------------------------------------------
EMAIL_SECRET_KEY=
EMAIL_SETUP_TOKEN=
EMAIL_CORS_ALLOW_ALL_ORIGINS=false
EMAIL_CORS_ALLOW_CREDENTIALS=false
EMAIL_CORS_ALLOWED_ORIGINS=
EMAIL_JWKS_CACHE_TTL=900
EMAIL_JWKS_TIMEOUT=15
EMAIL_JWKS_RETRIES=2
EMAIL_PUBLIC_URL=
DEFAULT_FROM_EMAIL=no-reply@shellui.com
DEFAULT_FROM_NAME=Shellui
BULK_FROM_EMAIL=news@news.shellui.com
BULK_FROM_NAME=Shellui
EMAIL_NEWSLETTER_IP_PER_HOUR=10
EMAIL_NEWSLETTER_ADDRESS_PER_DAY=3
EMAIL_NEWSLETTER_LIST_PER_HOUR=500
EMAIL_NEWSLETTER_CONFIRM_HOURS=48
EMAIL_NEWSLETTER_PENDING_DAYS=7
EMAIL_CLIENT_IP_HEADER=
EMAIL_FALLBACK_PROVIDER=none
EMAIL_PLATFORM_COMPANY_IDS=
EMAIL_ALLOW_COMPANY_SMTP=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# generated
EMAIL_CREDENTIALS_KEY=
# generated
EMAIL_VARIABLES_KEY=
# generated
EMAIL_HASH_PEPPER=
EMAIL_AUTH_DEFAULT_TTL_SECONDS=120
EMAIL_AUTH_MAX_TTL_SECONDS=300
EMAIL_MESSAGE_RETENTION_DAYS=30
EMAIL_IDEMPOTENCY_HOURS=24
EMAIL_COMPANY_TRANSACTIONAL_PER_HOUR=1000
EMAIL_RECIPIENT_AUTH_LIMIT=5
EMAIL_RECIPIENT_AUTH_WINDOW_SECONDS=600
EMAIL_COMPANY_AUTH_LIMIT=30
EMAIL_COMPANY_AUTH_WINDOW_SECONDS=60
EMAIL_NODE_BINARY=node
EMAIL_DELIVER_SYNC=false
EMAIL_GUNICORN_WORKERS=2
EMAIL_GUNICORN_THREADS=2
EMAIL_GUNICORN_TIMEOUT=120
EMAIL_ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
EMAIL_ACTIONS_OUTBOX_MAX_ATTEMPTS=8
EMAIL_ACTIONS_WEBHOOK_ALLOW_PRIVATE=false
EMAIL_ACTIONS_WEBHOOK_SYNC_DELIVERY=false
EMAIL_EVENT_LOG_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# First superuser (optional)
# Leave commented and run createsuperuser from the docs, or uncomment all three.
# There is no default password. is_staff and is_superuser are set only by
# Django's createsuperuser command (or later in Django admin).
# ---------------------------------------------------------------------------
# SHELLUI_SUPERUSER_USERNAME=
# SHELLUI_SUPERUSER_EMAIL=
# SHELLUI_SUPERUSER_PASSWORD=

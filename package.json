{
  "name": "shellui",
  "version": "0.7.0",
  "description": "Shellui repository - CLI, Core, and SDK packages",
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "shellui": "packages/cli/bin/shellui.js"
  },
  "scripts": {
    "build": "node packages/cli/bin/shellui.js build",
    "build:packages": "pnpm -r run build",
    "build:cli": "pnpm --filter @shellui/cli run build",
    "build:sdk": "pnpm --filter @shellui/sdk run build",
    "build:all": "pnpm run build:cli && pnpm run build:sdk",
    "serve": "node packages/cli/bin/shellui.js start",
    "start": "node packages/cli/bin/shellui.js start",
    "init": "node packages/cli/bin/shellui.js init",
    "test": "pnpm -r --if-present run test",
    "clean": "pnpm -r run clean --if-present && rm -rf node_modules",
    "publish": "node scripts/publish-with-tag.js",
    "docs:install": "cd tools/docusaurus && pnpm install",
    "docs:fetch": "node tools/docusaurus/scripts/fetch-service-docs.js",
    "docs:start": "pnpm run build:sdk && pnpm run docs:fetch && cd tools/docusaurus && pnpm start",
    "docs:build": "pnpm run build:sdk && pnpm run docs:fetch && cd tools/docusaurus && pnpm run build",
    "docs:serve": "cd tools/docusaurus && pnpm run serve",
    "serve:dist": "node packages/cli/scripts/serve-dist.mjs",
    "tauri:install": "pnpm --filter @shellui/tauri run install:deps",
    "tauri:dev": "pnpm --filter @shellui/tauri run dev",
    "tauri:build": "pnpm --filter @shellui/tauri run build",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "lint": "pnpm exec eslint . && pnpm run format:check",
    "prepare": "husky",
    "version:sync": "node scripts/sync-package-versions.js",
    "changelog:check": "node scripts/check-changelog.js",
    "test:scripts": "node --test scripts/check-changelog.test.js"
  },
  "lint-staged": {
    "*": "pnpm exec prettier --write --ignore-unknown"
  },
  "keywords": [
    "monorepo",
    "shellui",
    "microfrontend"
  ],
  "author": "Shellui",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "compression": "^1.8.2",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2",
      "launch-editor": "^2.14.2",
      "tinypool@<2.1.2": "^2.1.2",
      "websocket-driver": "^0.7.5",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "@babel/core": "^7.29.6",
      "body-parser@<1.20.9": "^1.20.9",
      "flatted": "^3.4.2",
      "joi": "^17.13.9",
      "lodash": "^4.18.0",
      "minimatch@3": "^3.1.4",
      "minimatch@5": "^5.1.8",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3",
      "picomatch@4": "^4.0.4",
      "rollup@2": "^2.80.0",
      "rollup@4": "^4.59.0",
      "serialize-javascript": "^7.1.3",
      "ws@7": "^7.5.11",
      "ws@8": "^8.21.0",
      "zod@4": "^4.6.6",
      "fast-uri": "^3.1.9",
      "ajv@6": "^6.14.0",
      "ajv@8": "^8.18.0",
      "follow-redirects": "^1.16.0",
      "http-proxy-middleware@2": "^2.0.10",
      "postcss-selector-parser@6": "^6.1.5",
      "qs": "^6.16.1",
      "uuid@<11.1.1": "^11.1.1",
      "webpack-dev-server@5": "^5.2.6"
    }
  },
  "devDependencies": {
    "@shellui/core": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
